# Copy to .env and fill in. Never commit real values.

# --- Database (PostgreSQL) ---
# Pooled connection used by the API at runtime.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/car_dealer_dev"
# Direct (non-pooled) connection used by `prisma migrate`. Same as DATABASE_URL locally.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/car_dealer_dev"

# Used only by integration tests (apps/api `pnpm test:int`). Must be a throwaway database: tests TRUNCATE tables.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/car_dealer_test"

# --- Supabase ---
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_ANON_KEY="<anon key>"
# Server-only. Used by the API for Storage signed uploads. NEVER expose to browsers.
SUPABASE_SERVICE_ROLE_KEY="<service role key>"
SUPABASE_STORAGE_BUCKET="vehicle-images"
# Used by the API to verify access tokens independently of the web apps.
SUPABASE_JWKS_URL="https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json"
SUPABASE_JWT_ISSUER="https://<project-ref>.supabase.co/auth/v1"

# --- API (apps/api) ---
API_PORT=4000
# 0.0.0.0 lets phones/emulators on your network reach the API. Use 127.0.0.1 to restrict it to this machine.
API_HOST=0.0.0.0
# Comma-separated list of browser origins allowed to call the API.
API_CORS_ORIGINS="http://localhost:3000,http://localhost:3001"
API_RATE_LIMIT_TTL_SECONDS=60
API_RATE_LIMIT_MAX=120
API_STRICT_RATE_LIMIT_MAX=10
RESERVATION_HOLD_MINUTES=60

# --- Web apps ---
# Server-side base URL of the API (used by Server Components / Server Actions).
API_BASE_URL="http://localhost:4000"

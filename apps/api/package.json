{
  "name": "@car-dealer/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "dotenv -e ../../.env -- nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "pnpm test:unit && pnpm test:int",
    "test:unit": "jest --config jest.config.js",
    "test:int": "dotenv -e ../../.env -- jest --config test/jest-int.config.js --runInBand"
  },
  "dependencies": {
    "@car-dealer/contracts": "workspace:*",
    "@car-dealer/database": "workspace:*",
    "@car-dealer/utils": "workspace:*",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/throttler": "^6.4.0",
    "@supabase/supabase-js": "^2.58.0",
    "helmet": "^8.1.0",
    "jose": "^5.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@car-dealer/eslint-config": "workspace:*",
    "@car-dealer/typescript-config": "workspace:*",
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.1.6",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.18.1",
    "@types/supertest": "^6.0.3",
    "dotenv-cli": "^10.0.0",
    "eslint": "^9.36.0",
    "jest": "^29.7.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.4",
    "typescript": "~5.9.3"
  }
}

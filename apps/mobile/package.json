{
  "name": "@car-dealer/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --go",
    "start:dev-client": "expo start --dev-client",
    "dev": "expo start --go",
    "ios": "expo start --go --ios",
    "android": "expo start --go --android",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "expo:doctor": "npx --yes expo-doctor",
    "prebuild:dev": "APP_VARIANT=development expo prebuild --clean",
    "run:ios": "APP_VARIANT=development expo run:ios",
    "run:android": "APP_VARIANT=development expo run:android",
    "eas:dev:ios": "eas build --profile development --platform ios",
    "eas:dev:ios-simulator": "eas build --profile development-simulator --platform ios",
    "eas:dev:android": "eas build --profile development --platform android"
  },
  "dependencies": {
    "@car-dealer/api-client": "workspace:*",
    "@car-dealer/contracts": "workspace:*",
    "@car-dealer/utils": "workspace:*",
    "@expo/vector-icons": "^15.0.2",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react-native": "^1.0.16",
    "@maplibre/maplibre-react-native": "^11.5.0",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@supabase/supabase-js": "^2.58.0",
    "@tanstack/react-query": "^5.90.0",
    "clsx": "^2.1.1",
    "expo": "~58.0.19",
    "expo-blur": "~58.0.5",
    "expo-build-properties": "~58.0.11",
    "expo-camera": "~58.0.12",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.15",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.11",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.17",
    "expo-image-manipulator": "~58.0.15",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-location": "~58.0.19",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-view-shot": "6.1.1",
    "react-native-worklets": "0.13.0",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.1.13",
    "uniwind": "^1.13.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@car-dealer/typescript-config": "workspace:*",
    "@types/react": "~19.3.0",
    "eas-cli": "^16.0.0",
    "eslint": "^9.36.0",
    "eslint-config-expo": "~58.0.0",
    "typescript": "~6.0.3",
    "vitest": "^3.2.4"
  }
}

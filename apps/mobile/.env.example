# Copy to apps/mobile/.env. Expo inlines EXPO_PUBLIC_* values into the app bundle, so NEVER put secrets here.
# (No database URL, no Supabase service-role key, no private API keys.)

# Base URL of the NestJS API. The API has no /v1 prefix and listens on port 4000.
#  - Physical phone: your computer's LAN IP, e.g. http://192.168.1.20:4000   (NOT localhost)
#  - Android emulator: http://10.0.2.2:4000
#  - iOS simulator:   http://localhost:4000
# If left empty, development builds derive it from the Metro host (works for Expo Go over LAN and simulators).
# Staging/production MUST be https://.
EXPO_PUBLIC_API_URL=

# Supabase project URL and the PUBLIC anon/publishable key (Settings → API).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
